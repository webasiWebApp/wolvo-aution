# Copy to .env and fill in local values. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=wolvo_db
# Database the e2e tests create and drop. Must differ from DB_DATABASE.
DB_TEST_DATABASE=wolvo_test
# Long random string used to sign access tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
# Listing creation rate limit, per user.
LISTING_CREATE_LIMIT=10
LISTING_CREATE_TTL_MS=3600000
# Opens and closes listings on schedule. Set to false to turn off.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
# File storage. Only "local" exists for now; an unknown value stops startup.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# At least 32 random characters; signs private file links.
STORAGE_SIGNING_SECRET=change-me-to-a-long-random-string-32-chars-min
STORAGE_MAX_FILE_MB=10
