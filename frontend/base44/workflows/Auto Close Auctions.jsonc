{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Australia/Perth",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Auto Close Auctions",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_close_auctions",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "close_expired": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCloseAuctions"
          },
          "then": "end",
          "x-base44": {
            "title": "Close expired auctions",
            "description": "Settle auctions past their closing time"
          }
        }
      }
    ]
  },
  "description": "Closes every open auction whose closing time has passed, creating the winner's transaction automatically so the winning bidder can pay."
}