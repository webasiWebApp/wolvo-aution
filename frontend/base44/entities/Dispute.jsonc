{
  "name": "Dispute",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "auction_id": {
      "type": "string"
    },
    "filed_by": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dispute_type": {
      "type": "string",
      "enum": [
        "non_payment",
        "item_not_as_described",
        "collection_issue",
        "payment_issue",
        "other"
      ],
      "default": "other"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_review",
        "resolved",
        "dismissed"
      ],
      "default": "open"
    },
    "resolution": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "filed_by",
    "subject",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.filed_by": "{{user.id}}"
        },
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}