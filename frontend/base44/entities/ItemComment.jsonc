{
  "name": "ItemComment",
  "type": "object",
  "properties": {
    "auction_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "parent_comment_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "visible",
        "hidden"
      ],
      "default": "visible"
    },
    "reported": {
      "type": "boolean",
      "default": false
    },
    "report_reason": {
      "type": "string"
    }
  },
  "required": [
    "auction_id",
    "user_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "visible"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}