{
  "name": "CollectionAppointment",
  "type": "object",
  "properties": {
    "auction_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "slot_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "party_size": {
      "type": "number",
      "default": 1
    },
    "collection_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "scheduled"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "collected_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "auction_id",
    "user_id",
    "scheduled_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}