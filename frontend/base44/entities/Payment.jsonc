{
  "name": "Payment",
  "type": "object",
  "properties": {
    "auction_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "AUD"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "payid",
        "bank_transfer",
        "manual"
      ],
      "default": "manual"
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_payment",
        "processing",
        "paid",
        "failed",
        "expired",
        "refund_pending",
        "partially_refunded",
        "refunded",
        "canceled"
      ],
      "default": "awaiting_payment"
    },
    "provider": {
      "type": "string"
    },
    "provider_reference": {
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    },
    "customer_reference": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "instructions_snapshot": {
      "type": "string"
    },
    "client_secret": {
      "type": "string"
    },
    "confirmed_by": {
      "type": "string"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "refund_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "partial",
        "refunded"
      ],
      "default": "none"
    },
    "refunded_amount": {
      "type": "number",
      "default": 0
    },
    "failure_reason": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}