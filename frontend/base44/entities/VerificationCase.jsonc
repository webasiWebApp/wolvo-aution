{
  "name": "VerificationCase",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "residential_address": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "UNVERIFIED",
        "PENDING",
        "VERIFIED",
        "REJECTED",
        "RESTRICTED"
      ],
      "default": "PENDING"
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "has_primary_identity": {
      "type": "boolean",
      "default": false
    },
    "has_address_evidence": {
      "type": "boolean",
      "default": false
    },
    "combination_met": {
      "type": "boolean",
      "default": false
    },
    "review_type": {
      "type": "string",
      "enum": [
        "standard",
        "alternative",
        "exception"
      ],
      "default": "standard"
    },
    "requires_manual_review": {
      "type": "boolean",
      "default": false
    },
    "provider_verified": {
      "type": "boolean",
      "default": false
    },
    "provider_reference": {
      "type": "string"
    },
    "external_verification_status": {
      "type": "string",
      "enum": [
        "not_required",
        "awaiting",
        "passed",
        "failed"
      ],
      "default": "not_required"
    },
    "user_facing_explanation": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_by": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "verification_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}