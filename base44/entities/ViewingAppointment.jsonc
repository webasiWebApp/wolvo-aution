{
  "name": "ViewingAppointment",
  "type": "object",
  "properties": {
    "auction_id": {
      "type": "string"
    },
    "slot_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "requested_slot": {
      "type": "string",
      "format": "date-time"
    },
    "party_size": {
      "type": "number",
      "default": 1
    },
    "booking_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "confirmed",
        "declined",
        "cancelled",
        "completed"
      ],
      "default": "requested"
    },
    "check_in_status": {
      "type": "string",
      "enum": [
        "pending",
        "checked_in",
        "no_show"
      ],
      "default": "pending"
    },
    "address_released": {
      "type": "boolean",
      "default": false
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "auction_id",
    "user_id",
    "requested_slot"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}