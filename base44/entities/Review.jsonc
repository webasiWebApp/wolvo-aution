{
  "name": "Review",
  "type": "object",
  "properties": {
    "auction_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewee_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "hidden"
      ],
      "default": "published"
    },
    "flagged": {
      "type": "boolean",
      "default": false
    },
    "flag_reason": {
      "type": "string"
    },
    "flag_status": {
      "type": "string",
      "enum": [
        "none",
        "reported",
        "reviewed"
      ],
      "default": "none"
    }
  },
  "required": [
    "reviewer_id",
    "reviewee_id",
    "rating"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}